{
  "name": "sakura-rhine-archive",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "prepare": "node tools/rhine/patch-rolling-number.mjs",
    "content:build": "node tools/prepare-blog.mjs",
    "predev": "npm run content:build",
    "dev": "vite",
    "preserver": "npm run content:build",
    "server": "vite",
    "build": "npm run prepare && npm run content:build && tsc && vite build && node tools/finalize-blog.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 4000",
    "check": "npm run build && node tools/check-blog.mjs && npm run check:links",
    "check:links": "node tools/check-local-links.mjs",
    "check:browser": "node tools/check-blog-browser.mjs",
    "listening:chart": "node tools/generate-listening-chart.mjs",
    "music:update": "node tools/update-discovery-music.mjs",
    "netease:update": "node tools/update-netease-stats.mjs",
    "netease:comments": "node tools/update-netease-comments.mjs"
  },
  "dependencies": {
    "@kitlangton/rolling-number": "0.4.1",
    "three": "^0.183.0"
  },
  "devDependencies": {
    "@types/three": "^0.183.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "marked": "^16.4.0",
    "yaml": "^2.8.1",
    "cheerio": "^1.1.2",
    "sanitize-html": "^2.17.0",
    "playwright-core": "^1.62.1",
    "https-proxy-agent": "^7.0.6"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
